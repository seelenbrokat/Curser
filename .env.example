EZOLL_URL=https://zoll.ldv.at/ts/ts2/start_new.html
EZOLL_USER=dein_benutzer
EZOLL_PASSWORD=dein_passwort

# true = Browser sichtbar (empfohlen zum Mitverfolgen)
EZOLL_HEADED=true

# Optional: Chromium-Kanal, z.B. chrome oder msedge
# EZOLL_CHANNEL=chrome

# Bürgschaft-Abfrage
EZOLL_FIRMA=100
EZOLL_MSGTY=CC015C
# Leer = automatisch heute minus 6 Monate (YYYYMMDD)
# EZOLL_DATUM_VON=20260101
# Tabs vom Datumsfeld zum MsgTy-Feld (falls Cursor-Reihenfolge abweicht)
EZOLL_MSGTY_TABS=1
